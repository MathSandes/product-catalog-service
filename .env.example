# Desenvolvimento com API/worker no host e Postgres/Redis via Docker Compose:
# use as portas publicadas no compose (15432 / 16379), não 5432 / 6379 no host.
DATABASE_URL=postgresql://catalog:catalog@localhost:15432/catalog?schema=public
REDIS_URL=redis://localhost:16379
API_PORT=3000
NODE_ENV=development
VITE_API_URL=http://localhost:3000
