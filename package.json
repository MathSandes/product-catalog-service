{
  "name": "catalog-challenge",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @catalog/shared -w @catalog/database && npm run build -w @catalog/api -w @catalog/worker -w @catalog/web",
    "db:generate": "npm run db:generate -w @catalog/database",
    "db:migrate": "npm run db:migrate -w @catalog/database",
    "db:seed": "npm run db:seed -w @catalog/database",
    "test": "npm run test -w @catalog/shared -w @catalog/api -w @catalog/worker --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
